
Practical 5: File_Handling
Objective: Perform read, write and append operations on text, CSV and binary files.

Subject: Python for Data Science (BE05000231)

Note: Run the cells from top to bottom. This notebook is written in a simple practical/lab style.

Text file

# Write
with open("sample.txt", "w") as file:
    file.write("Python for Data Science\nPractical File Handling")

# Read
with open("sample.txt", "r") as file:
    print(file.read())

# Append
with open("sample.txt", "a") as file:
    file.write("\nNew line appended.")

with open("sample.txt", "r") as file:
    print(file.read())
     
CSV file

import csv

rows = [
    ["Name", "Age", "Marks"],
    ["Dharmik", 21, 85],
    ["Student2", 22, 78]
]

with open("students.csv", "w", newline="") as file:
    writer = csv.writer(file)
    writer.writerows(rows)

with open("students.csv", "r") as file:
    reader = csv.reader(file)
    for row in reader:
        print(row)
     
Binary file

data = b"Python Binary Data"

with open("sample.bin", "wb") as file:
    file.write(data)

with open("sample.bin", "rb") as file:
    print(file.read())
     
